---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css"
---

<Layout title="ARLISS CanSat Competition | CanSat Robotics Club">
    <Navbar sticky />
    <main class="payload-page">
        <header class="payload-header">
            <div class="payload-container">
                <h1>ARLISS CanSat Competition</h1>
            </div>
        </header>

        <section class="competition" id="arliss-comp">
            <div class="comp-intro">
                <h1 class="section-title">CanSat Comeback Competition</h1>
                <hr class="title-hr title-hr-1">

                <p class="comp-text">
                    This competition invites students from all around the world to design, build, and launch
                    autonomous robots 3 miles into the air.
                </p>
                <p class="comp-text">
                    From there, the robot must safely reach the ground and navigate to provided GPS coordinates. 
                </p>
            </div>
            <div class="arliss-contraints">
                <h1>Design Requirements</h1>
                <hr class="title-hr title-hr-2"/>

                <div class="constraint-grid">
                    <div class="constraint">
                        <h4>Size</h4>
                        <p>Stay within the competition's size requirements.</p>
                    </div>

                    <div class="constraint">
                        <h4>Weight</h4>
                        <p>Keep the complete robot within the weight limit.</p>
                    </div>

                    <div class="constraint">
                        <h4>Descent Speed</h4>
                        <p>Safely control how quickly the robot reaches the ground.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="launch-location">
            <div class="location-container">
                <div class="location-info">
                    <p class="eyebrow">WHERE WE LAUNCH</p>

                    <h2>
                        Black Rock
                        <span>Desert</span>
                    </h2>

                    <p class="location-state">
                        Nevada, USA
                    </p>
                </div>

                <div class="location-map">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m13!1m8!1m3!1d275777.8288796192!2d-119.23955156781888!3d40.80815368359306!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zNDDCsDUyJzE0LjUiTiAxMTnCsDA2JzI1LjAiVw!5e1!3m2!1sen!2sus!4v1769540598007!5m2!1sen!2sus" 
                        width="100%" height="450" 
                        style="border:0; display:block;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>

            <div class="comp-link">
                <h1><a
                    href="https://www.arliss.unisec.jp/competition/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hero-button"
                >
                    View The Official Regulations
                </a></h1>
                <hr class="title-hr title-hr-3"/>
            </div>
        </section>
     </main>
    <Footer />
</Layout>

<style>
    .payload-header {
        background:
            linear-gradient(rgba(110, 92, 75, 0.55), rgba(110, 92, 75, 0.55)),
            url("/assets/images/comp-photos/arliss-cover.png") center / cover no-repeat;
        min-height: 450px; /* optional: gives the image room to show */
        display: flex;
        align-items: flex-end; /* optional: sits the title at the bottom */
    }

    .title-hr-1 {
        width: 100%;
        margin-bottom: 2rem;
    }

    .title-hr-2 {
        width: 40%;
    }
    
    .title-hr-3 {
        width: 50%
    }

    .comp-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;

        padding-top: 7rem;
        padding-bottom: 15rem;
        
        font-size: 1.5rem;
        font-family: var(--main-font);
    }

    .comp-link h1 {
        margin-bottom: 0.5rem;
    }

    a, a:visited {
        color: var(--primary-blue);
        text-decoration: none;
    }

    .comp-intro {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;

        margin: 0 auto;

        max-width: 70%;
    }

    .comp-text {
        margin-top: 2rem;
        margin-bottom: 3rem;
        font-size: 28px;
        line-height: 48px;

        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.125);
    }

    .arliss-contraints {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;

        margin: 0 auto;

        max-width: 80%; 
    }

    .arliss-contraints h1 {
        margin-top: 5rem;
        margin-bottom: 0rem;
        font-size: 40px;
    } 

    .constraint-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .constraint {
        margin-top: 5rem;
        padding-top: 0rem;
        border-top: 2px solid currentColor;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.125);
    }

    .constraint h4 {
        margin-bottom: 0.75rem;
        font-size: 1.5rem;
    }

    .constraint p {
        margin: 0;
        color: var(--secondary-dark-brown);
        line-height: 1.6;
        font-size: 18px;
    }
</style>
