---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="ARLISS CanSat Competition | CanSat Robotics Club">
    <Navbar sticky />
    <main>
        <section class="competition" id="competition">
            <div class="container">
                <div class="section-intro">
                    <h1 class="section-title">CanSat Comeback Competition</h1>
                    <hr class="title-hr">
                </div>

                <div class="competition-process">

                    <div class="process-step">
                        <div class="process-icon">01</div>
                        <h3>Launch</h3>
                        <p>
                            Our robot is launched approximately
                            three miles into the air.
                        </p>
                    </div>

                    <div class="process-line"></div>

                    <div class="process-step">
                        <div class="process-icon">02</div>
                        <h3>Descend</h3>
                        <p>
                            The robot must safely reach the ground
                            while controlling its descent.
                        </p>
                    </div>

                    <div class="process-line"></div>

                    <div class="process-step">
                        <div class="process-icon">03</div>
                        <h3>Navigate</h3>
                        <p>
                            Once on the ground, the robot autonomously
                            navigates toward its GPS target.
                        </p>
                    </div>

                </div>


                <div class="constraints">
                    <div class="constraints-header">
                        <p class="eyebrow">DESIGN FREEDOM</p>

                        <h3>Our robots have few design requirements</h3>

                        <h1>The rest is up to us.</h1>
                    </div>


                    <div class="constraint-grid">

                        <div class="constraint">
                            <h4>Size</h4>
                            <p>Stay within the competition's size requirements.</p>
                        </div>

                        <div class="constraint">
                            <h4>Weight</h4>
                            <p>Keep the complete robot within the weight limit.</p>
                        </div>

                        <div class="constraint">
                            <h4>Descent Speed</h4>
                            <p>Safely control how quickly the robot reaches the ground.</p>
                        </div>

                    </div>
                </div>

                <div class="competition-footer">
                    <h1>Interested in official competition regulations?</h1>
                    <div class="hero-button">
                        <a
                            href="https://www.arliss.unisec.jp/competition/"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            View Competition Regulations
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="launch-location" id="location">
            <div class="location-container">

                <div class="location-info">

                    <p class="eyebrow">WHERE WE LAUNCH</p>

                    <h2>
                        Black Rock
                        <span>Desert</span>
                    </h2>

                    <p class="location-state">
                        Nevada, USA
                    </p>
                </div>


                <div class="location-map">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m13!1m8!1m3!1d275777.8288796192!2d-119.23955156781888!3d40.80815368359306!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zNDDCsDUyJzE0LjUiTiAxMTnCsDA2JzI1LjAiVw!5e1!3m2!1sen!2sus!4v1769540598007!5m2!1sen!2sus" 
                        width="100%" height="450" 
                        style="border:0; display:block;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </section>
   
        
    </main>
    <Footer />
</Layout>

<style>
    .title-hr {
        width: 85%;
    }
</style>
