---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

import { projects } from "../data/projects";
const projectNames = [
    ...projects.map((project) => project.name),
    "Business",
    "Social Media/Graphic Design",
]

const years = [
    "1st year",
    "2nd year",
    "3rd year",
    "4th+ year",
    "Graduate",
];
---

<Layout title="Join Us | CanSat Robotics Club">
    <Navbar sticky />

    <main class="payload-page">

        <header class="payload-header">
            <div class="payload-container">
                <h1>Join Us</h1>

                <p class="payload-tagline">
                    No experience required. Tell us a little about yourself and
                    we will get back to you as soon as possible.
                </p>
            </div>
        </header>


        <section class="join-section">
            <div class="join-container">

                <form
                    class="join-form"
                    action="https://api.web3forms.com/submit"
                    method="POST"
                >
                    <!--
                        PLACEHOLDER: replace the value below with the access key
                        from web3forms.com, registered to cansatrobotics@gmail.com.
                        Until then, submissions will be rejected by the endpoint.
                    -->
                    <input
                        type="hidden"
                        name="access_key"
                        value="b1e6c747-1490-4cfe-b6bb-407c02309079"
                    />

                    <input
                        type="hidden"
                        name="subject"
                        value="New join request from the CanSat website"
                    />

                    <!-- Spam trap: bots fill this in, people never see it. -->
                    <input
                        type="checkbox"
                        name="botcheck"
                        class="join-botcheck"
                        tabindex="-1"
                        autocomplete="off"
                    />

                    <div class="join-field">
                        <label for="name">Name</label>
                        <input
                            id="name"
                            name="name"
                            type="text"
                            required
                            autocomplete="name"
                        />
                    </div>

                    <div class="join-field">
                        <label for="email">Email</label>
                        <input
                            id="email"
                            name="email"
                            type="email"
                            required
                            autocomplete="email"
                        />
                    </div>

                    <div class="join-field">
                        <label for="year">Year</label>
                        <select id="year" name="year" required>
                            <option value="">Select one</option>
                            {years.map((year) => (
                                <option value={year}>{year}</option>
                            ))}
                        </select>
                    </div>

                    <div class="join-field">
                        <label for="payload">Which project interests you?</label>
                        <select id="payload" name="payload" required>
                            <option value="">Select one</option>
                            {projectNames.map((payload) => (
                                <option value={payload}>{payload}</option>
                            ))}
                        </select>
                    </div>

                    <div class="join-field">
                        <label for="notes">
                            Anything else you would like us to know?
                            <span class="join-optional">Optional</span>
                        </label>
                        <textarea id="notes" name="notes" rows="4"></textarea>
                    </div>

                    <button type="submit" class="join-submit">
                        Send
                    </button>
                </form>

                <aside class="join-aside">
                    <h2>What to expect</h2>

                    <p>
                        After a brief meeting with club leadership to evaluate interests and goals, new members are invited to join a team and contribute to an ongoing project.
                    </p>

                    <p>
                        Prefer email? Reach us at&nbsp;<a
                            href="mailto:cansatrobotics@gmail.com"
                        >cansatrobotics@gmail.com</a>.
                    </p>
                </aside>

            </div>
        </section>

    </main>
    <Footer />
</Layout>
