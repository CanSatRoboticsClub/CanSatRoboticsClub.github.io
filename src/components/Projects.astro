---
import { projects } from "../data/projects.ts";
---

<section class="projects" id="projects">
    <div class="projects-heading">
        <h1 class="section-title">Our Current Projects</h1>
        <hr class="title-hr">
    </div>

    <!-- Each row is one link to its project page. aria-label gives screen
         readers a short name instead of reading every line of the row. -->
    <div class="project-list">
        {projects.map((project, index) => (
            <a
                href={`/projects/${project.slug}`}
                aria-label={`${project.name}: learn more`}
                class:list={[
                    "project",
                    `project-${project.slug}`,
                    { "image-left": index % 2 === 1 },
                ]}
            >
                <div class="project-image">
                    <img
                        src={project.image}
                        alt={project.name}
                    />
                </div>

                <div class="project-text">
                    <h2>{project.name}</h2>
                    <p>{project.description}</p>
                    <p class="eyebrow">COMPETITION: {project.competition}</p>

                    <!-- Mobile-only hint: the whole row is the link, so this just tells people to tap. -->
                    <p class="tap-hint">Tap the image to learn more</p>
                </div>
            </a>
        ))}
    </div>
</section>

<style>
    .title-hr {
        width: 45%;
    }

    .project-text p {
        margin: 0.15rem 0.1 0.15rem; /* top, sides, bottom */
    }

    .eyebrow {
        font-size: 14px;
    }

    .tap-hint {
        display: none;
        font-size: 0.85rem;
        font-style: italic;
        opacity: 0.8;
    }

    @media (max-width: 700px) {
        .tap-hint {
            display: block;
        }

        .project {
            flex-direction: column;
        }

        .project-image,
        .project-text {
            width: 100%;
        }

        .project-image {
            height: 350px;
        }

        .project-text,
        .project:not(.image-left) .project-text,
        .image-left .project-text {
            padding: 3rem 2rem;
        }

        .project:not(.image-left) .project-image,
        .image-left .project-image {
            justify-content: center;
            padding: 0 2rem;
        }

        .project-rover .project-text,
        .project-hamster-ball .project-text {
            left: 0;
        }

        .project-image,
        .project-text,
        .image-left .project-image,
        .image-left .project-text,
        .project:not(.image-left) .project-image,
        .project:not(.image-left) .project-text {
            order: initial;
        }
    }
</style>
