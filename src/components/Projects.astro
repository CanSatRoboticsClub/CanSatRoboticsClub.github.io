---
import { projects } from "../data/projects.ts";
---

<section class="projects" id="projects">
    <div class="projects-heading">
        <h1 class="section-title">Our Current Projects</h1>
        <hr class="title-hr">
    </div>

    <!-- Each row is one link to its project page. aria-label gives screen
         readers a short name instead of reading every line of the row. -->
    <div class="project-list">
        {projects.map((project, index) => (
            <a
                href={`/projects/${project.slug}`}
                aria-label={`${project.name}: learn more`}
                class:list={[
                    "project",
                    `project-${project.slug}`,
                    { "image-left": index % 2 === 1 },
                ]}
            >
                <div class="project-image">
                    <img
                        src={project.image}
                        alt={project.name}
                    />
                </div>

                <div class="project-text">
                    <h2>{project.name}</h2>
                    <p>{project.description}</p>

                    <!-- Looks like a button, but is a plain label: the whole row
                         is already the link, and links can't contain links. -->
                    <div class="project-buttons">
                        <span class="project-button">Learn More</span>
                    </div>
                </div>
            </a>
        ))}
    </div>
</section>

<style>
    .title-hr {
        width: 45%;
    }
</style>
